APP_NAME="Lufly Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost/lufly
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=UTC

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lufly
DB_USERNAME=root
DB_PASSWORD=

LOG_LEVEL=debug
LOG_CHANNEL=app

CACHE_DRIVER=file
SESSION_LIFETIME=7200

MAIL_TRANSPORT=log
MAIL_FROM_ADDRESS=no-reply@lufly.test
MAIL_FROM_NAME="Lufly Platform"

UPLOAD_DISK=local
UPLOAD_MAX_SIZE=10240

SECURITY_BCRYPT_COST=12
SECURITY_LOGIN_MAX_ATTEMPTS=5
SECURITY_LOGIN_LOCKOUT_SECONDS=300
